# Copy to .env and adjust for your machine: cp .env.example .env
# Every variable is validated at startup (src/config/env.ts).

# Runtime environment: development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# Origin allowed to call the API from the browser (the Next.js app)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string; must match the root .env used by docker compose
DATABASE_URL=postgresql://anwar_shah:change-me@localhost:5432/anwar_shah_and_sons?schema=public

# Signs auth cookies and tokens. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Public URL of the web app; it proxies /api/auth/* to this API
BETTER_AUTH_URL=http://localhost:3000

# Store currency (ISO 4217) and locale for formatting prices
STORE_CURRENCY=PKR
STORE_LOCALE=en-PK

# Admin account created by `npm run db:seed` (only read by the seed script)
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
