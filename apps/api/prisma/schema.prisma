// Prisma schema: https://www.prisma.io/docs/orm/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (Better Auth) ────────────────────────────────────────────────────
// Field names follow Better Auth's core schema plus the admin plugin
// (role, ban fields, impersonation). Tables and columns use snake_case.

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  /// System role: "customer" (default) or "admin". See @repo/shared roles.
  role          String    @default("customer")
  banned        Boolean?  @default(false)
  banReason     String?   @map("ban_reason")
  banExpires    DateTime? @map("ban_expires")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  sessions Session[]
  accounts Account[]

  @@map("users")
}

model Session {
  id             String   @id
  token          String   @unique
  expiresAt      DateTime @map("expires_at")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  impersonatedBy String?  @map("impersonated_by")
  userId         String   @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Credentials per sign-in method. For email and password, `password` holds the hash.
model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

/// Short-lived tokens, e.g. for email verification and password reset.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ─── Catalog ───────────────────────────────────────────────────────────────

/// Browsing hierarchy, e.g. Women > Kurtas. A category with sub-categories can't be deleted.
model Category {
  id          String   @id @default(cuid(2))
  name        String
  slug        String   @unique
  description String?
  parentId    String?  @map("parent_id")
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId, position])
  @@map("categories")
}

enum OptionKind {
  text
  color

  @@map("option_kind")
}

/// An admin-defined product option such as Size, Colour or Fit.
model OptionType {
  id        String     @id @default(cuid(2))
  name      String
  slug      String     @unique
  kind      OptionKind @default(text)
  position  Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  values   OptionValue[]
  products ProductOption[]

  @@map("option_types")
}

/// A choice within an option type, e.g. "M" for Size or "Black" (#1a1a1a) for Colour.
model OptionValue {
  id           String   @id @default(cuid(2))
  optionTypeId String   @map("option_type_id")
  label        String
  slug         String
  colorHex     String?  @map("color_hex")
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  optionType OptionType           @relation(fields: [optionTypeId], references: [id], onDelete: Cascade)
  variants   VariantOptionValue[]

  @@unique([optionTypeId, slug], map: "option_values_slug_key")
  @@index([optionTypeId, position])
  @@map("option_values")
}

enum ProductStatus {
  draft
  active
  archived

  @@map("product_status")
}

/// Prices are integers in the store currency's minor unit (see @repo/shared money).
/// CHECK constraints in the migration keep prices and stock non-negative.
model Product {
  id             String        @id @default(cuid(2))
  name           String
  slug           String        @unique
  description    String?
  categoryId     String        @map("category_id")
  status         ProductStatus @default(draft)
  price          Int
  compareAtPrice Int?          @map("compare_at_price")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  options  ProductOption[]
  variants ProductVariant[]

  @@index([status, categoryId])
  @@map("products")
}

/// An option type a product varies by, e.g. Size. Types in use can't be deleted.
model ProductOption {
  productId    String @map("product_id")
  optionTypeId String @map("option_type_id")
  position     Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionType OptionType @relation(fields: [optionTypeId], references: [id], onDelete: Restrict)

  @@id([productId, optionTypeId])
  @@map("product_options")
}

/// A sellable combination of option values, e.g. Size M + Colour Black.
model ProductVariant {
  id             String   @id @default(cuid(2))
  productId      String   @map("product_id")
  sku            String   @unique
  /// Overrides the product price when set.
  price          Int?
  stock          Int      @default(0)
  position       Int      @default(0)
  /// Sorted option value ids joined with "+": one variant per combination.
  combinationKey String   @map("combination_key")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues VariantOptionValue[]

  @@unique([productId, combinationKey], map: "product_variants_combination_key")
  @@index([productId, position])
  @@map("product_variants")
}

/// The option values that define a variant. Values in use can't be deleted.
model VariantOptionValue {
  variantId     String @map("variant_id")
  optionValueId String @map("option_value_id")

  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue OptionValue    @relation(fields: [optionValueId], references: [id], onDelete: Restrict)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("variant_option_values")
}
