# Copy to .env.local and adjust for your machine: cp .env.example .env.local
# Server-side variables are validated at request time (src/lib/env.ts).

# Base URL of the NestJS API, reachable from the Next.js server
API_URL=http://localhost:4000

# Public URL of the store, for absolute links in metadata, the sitemap and
# structured data. Read at build time, so set it for builds too.
SITE_URL=http://localhost:3000
