# Copy to .env and adjust for your machine: cp .env.example .env
# Every variable is validated at startup (src/config/env.ts).

# Runtime environment: development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# Origin allowed to call the API from the browser (the Next.js app)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string; must match the root .env used by docker compose
DATABASE_URL=postgresql://anwar_shah:change-me@localhost:5432/anwar_shah_and_sons?schema=public

# Signs auth cookies and tokens. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Public URL of the web app; it proxies /api/auth/* to this API
BETTER_AUTH_URL=http://localhost:3000

# Store currency (ISO 4217) and locale for formatting prices
STORE_CURRENCY=PKR
STORE_LOCALE=en-PK
# Time zone for "today" on the admin dashboard (IANA name)
STORE_TIMEZONE=Asia/Karachi

# Guest carts left untouched this many days are deleted by a daily job
GUEST_CART_TTL_DAYS=60

# Shipping per order, in major units of STORE_CURRENCY; orders at or above
# FREE_SHIPPING_OVER ship free (leave it unset for no free-shipping offer)
SHIPPING_FLAT_RATE=250
# FREE_SHIPPING_OVER=5000

# Card payments through Stripe Checkout. Leave the key unset for cash on delivery
# only. Use test keys (sk_test_...) from https://dashboard.stripe.com/test/apikeys.
# The webhook secret comes from `stripe listen --forward-to
# localhost:4000/api/v1/webhooks/stripe`, or the webhook's page in the dashboard.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Minutes a customer has to pay; stock is held until then (31 to 1440)
# PAYMENT_WINDOW_MINUTES=60

# Email: "log" prints emails to this console (development); "smtp" sends them,
# e.g. through AWS SES's SMTP endpoint. SMTP_HOST is required for smtp.
EMAIL_DRIVER=log
EMAIL_FROM=Anwar Shah & Sons <no-reply@localhost>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Uploaded media: "local" (a directory) or "s3"
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
# Required for STORAGE_DRIVER=s3. Credentials come from the AWS default chain
# (e.g. an ECS task role), never from this file. S3_ENDPOINT is for MinIO etc.
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=

# Admin account created by `npm run db:seed` (only read by the seed script)
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
