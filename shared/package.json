{
  "name": "@repo/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Contracts shared by the web and api apps: Zod schemas and their inferred types",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "vitest": "^4.1.12"
  }
}
